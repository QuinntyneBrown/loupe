@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Generate visual metadata suggestions
Person(owner, "Library owner", "Uses this capability")
System_Boundary(loupe, "Loupe") {
Container(spa, "Loupe web", "Angular", "ReferenceDetailPage")
Container(api, "Loupe API", "ASP.NET Core", "MetadataController")
ContainerDb(db, "Library store", "Relational storage; engine TO SUPPLY", "Owned records, versions, and durable work")
Container(worker, "Loupe worker", ".NET hosted service", "Leases persisted work and dispatches Application handlers")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls via interface-bound HTTP adapter", "JSON or multipart / HTTPS")
Rel(api, db, "Reads or commits owned state", "Infrastructure adapter")
Rel(worker, db, "Leases durable work and conditionally publishes", "Infrastructure adapter")
System_Ext(external, "Configured external services", "Providers or permitted source content")
Rel(worker, external, "Calls bounded adapters", "HTTPS")
@enduml
