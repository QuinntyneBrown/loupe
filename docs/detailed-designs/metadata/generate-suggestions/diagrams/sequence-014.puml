@startuml
title L2-014 - Generate visual descriptions and categorized tags
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Library owner" as actor
box "Frontend - Loupe application / domain / api" #E0F2FE
participant "MetadataSuggestionPanel" as page
participant "MetadataService" as client
end box
box "Backend - Loupe API application" #D1FADF
participant "MetadataController" as controller
end box
box "Backend - Loupe Application and Domain" #ECFDF3
participant "GenerateVisualSuggestionsCommandHandler" as handler
participant "GetOperationQueryHandler" as status
participant "SuggestionBatch" as entity
end box
box "Backend - Loupe Infrastructure" #FFF4E5
database "Library store" as db
participant "IVisualMetadataProvider adapters" as ext
participant "Durable work runner" as worker
end box
note over page, controller : Admission persists work before processing; status reads are owner-scoped
worker -> db : Lease admitted job and immutable input
db --> worker : Durable work
worker -> handler : Dispatch GenerateVisualSuggestionsCommand
handler -> db : Verify target owner, existence, and admitted revision
db --> handler : Current authorized state
alt no image
handler --> worker : Image needed; no provider call [L2-014]
else current validated image
handler -> ext : Generate description and seven-category tags
ext --> handler : Candidate batch
handler -> entity : Validate lengths, categories, complete response
alt malformed, overlength, or unsupported category
handler -> db : Fail attempt without partial publication
else valid result
handler -> db : Publish unreviewed batch only if image revision current
db --> handler : AI-suggested values, timestamp, mode; notes unchanged
end
end
handler --> worker : Attempt outcome; release lease
actor -> page : Inspect processing result
page -> client : Read status
client -> controller : GET owned job / item status
controller -> status : Dispatch GetOperationQuery
status -> db : Read persisted state
db --> status : Job outcome and current item
status --> controller : Typed status
controller --> client : pending suggestions / failed attempt
client --> page : Update state signals
page --> actor : Labeled result and recovery action
@enduml
