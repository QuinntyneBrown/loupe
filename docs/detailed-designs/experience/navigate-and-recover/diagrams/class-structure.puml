@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

title Class structure - Navigate the library and recover unfinished edits
class EditorDraft {
  +OwnerId: string
  +Route: string
  +Text: string
  +Dirty: bool
  +Discard(): void
  +RestoreFor(ownerId: string): bool
}
class LibraryShell {
  +Open(input: EditorDraft): void
}
class LibraryStatePanel {
  +State: EditorDraft
  +Render(): void
}
LibraryShell ..> LibraryStatePanel : composes / runs
LibraryStatePanel --> EditorDraft : reads / evaluates
@enduml
