@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Keep search current as the library changes
Container(spa, "SearchIndexStatus", "Angular domain", "Injects SEARCH_INDEX_SERVICE")
Container_Boundary(api, "Loupe API and Application") {
Component(ctrl, "SearchIndexController", "API controller", "Binds, dispatches, returns")
Component(handler, "RefreshSearchDocumentCommandHandler", "Application / MediatR 12.5.0", "Validates, authorizes, coordinates slice")
Component(entity, "SearchDocument", "Domain", "State and local invariants")
Component(store, "ILibraryStore", "Application port", "Owner-scoped transactional reads and writes")
}
ContainerDb(db, "Library store", "Infrastructure adapter", "Authoritative data and durable work")
Rel(spa, ctrl, "Calls through ISearchIndexService", "HTTPS")
Rel(ctrl, handler, "Dispatches request", "MediatR")
Rel(handler, entity, "Reads or applies behavior")
Rel(handler, store, "Uses inward-defined port")
Rel(store, db, "Implemented by Infrastructure")
Container(worker, "Loupe worker", ".NET", "Processes durable admitted work")
Rel(worker, handler, "Dispatches background command", "MediatR")
Component(ports, "IEmbeddingProvider / IVectorWriter", "Application ports", "Implemented by configured Infrastructure adapters")
Rel(handler, ports, "Uses explicit capability")
@enduml
