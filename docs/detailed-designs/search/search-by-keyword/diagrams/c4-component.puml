@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Search library text with combined filters
Container(spa, "SearchResults", "Angular domain", "Injects SEARCH_SERVICE")
Container_Boundary(api, "Loupe API and Application") {
Component(ctrl, "SearchController", "API controller", "Binds, dispatches, returns")
Component(handler, "KeywordSearchQueryHandler\nValidateSearchFiltersQueryHandler", "Application / MediatR 12.5.0", "Validates, authorizes, coordinates slice")
Component(entity, "SearchFilter", "Domain", "State and local invariants")
Component(store, "ILibraryStore", "Application port", "Owner-scoped transactional reads and writes")
}
ContainerDb(db, "Library store", "Infrastructure adapter", "Authoritative data and durable work")
Rel(spa, ctrl, "Calls through ISearchService", "HTTPS")
Rel(ctrl, handler, "Dispatches request", "MediatR")
Rel(handler, entity, "Reads or applies behavior")
Rel(handler, store, "Uses inward-defined port")
Rel(store, db, "Implemented by Infrastructure")
Component(ports, "ILibrarySearchReader", "Application ports", "Implemented by configured Infrastructure adapters")
Rel(handler, ports, "Uses explicit capability")
@enduml
