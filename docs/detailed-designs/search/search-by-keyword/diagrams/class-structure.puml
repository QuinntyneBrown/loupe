}
interface ILibraryStore {
  +ReadOwned(ownerId: string, id: Guid): Task<OwnedState>
  +Commit(expectedVersion: long): Task<CommitResult>
}
class KeywordSearchQuery {
  +OwnerId: string
  +Payload: KeywordSearchInput
}
class KeywordSearchQueryHandler {
  +Handle(request: KeywordSearchQuery, cancellation: CancellationToken): Task<Result>
}
