@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Save, edit, and browse photographer bookmarks
Person(owner, "Library owner", "Uses this capability")
System_Boundary(loupe, "Loupe") {
Container(spa, "Loupe web", "Angular", "PhotographerDetailPage")
Container(api, "Loupe API", "ASP.NET Core", "PhotographersController")
ContainerDb(db, "Library store", "Relational storage; engine TO SUPPLY", "Owned records, versions, and durable work")
}
Rel(owner, spa, "Uses", "HTTPS")
Rel(spa, api, "Calls via interface-bound HTTP adapter", "JSON or multipart / HTTPS")
Rel(api, db, "Reads or commits owned state", "Infrastructure adapter")
@enduml
