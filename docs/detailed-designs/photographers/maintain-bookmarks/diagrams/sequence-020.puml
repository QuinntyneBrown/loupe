@startuml
title L2-020 - Save and edit photographer bookmarks
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Library owner" as actor
box "Frontend - Loupe application / domain / api" #E0F2FE
participant "PhotographerDetailPanel" as page
participant "PhotographerService" as client
end box
box "Backend - Loupe API application" #D1FADF
participant "PhotographersController" as controller
end box
box "Backend - Loupe Application and Domain" #ECFDF3
participant "SavePhotographerCommandHandler" as handler
participant "PhotographerBookmark" as entity
end box
box "Backend - Loupe Infrastructure" #FFF4E5
database "Library store" as db
end box
actor -> page : Save and edit photographer bookmarks
page -> client : name, portfolioUrl, summary?, notes?, tags?, version?
client -> controller : POST /api/photographers; PUT /api/photographers/{id}
note over controller : API middleware authenticates; controller binds only
controller -> handler : MediatR dispatch SavePhotographerCommand
handler -> db : Load / validate owner-scoped state before side effects
db --> handler : Owned state or unavailable result
handler -> entity : Validate name, URL, manual fields; normalize URL [L2-020]
handler -> db : Owner-scoped unique URL insert / conditional edit
alt duplicate create
db --> handler : Existing owned bookmark; Already saved
else URL conflicts on edit
db --> handler : 409; preserve both bookmarks
else valid create/edit
db --> handler : Usable saved bookmark; links preserved
opt portfolio URL changed
handler -> entity : Prior suggestions belong to old URL
note over db : Same transaction invalidates old machine search input
end
end
handler --> controller : 201 create / 200 edit or existing bookmark; no fetch on invalid input
controller --> client : Typed HTTP response / ProblemDetails
client --> page : Update state signals
page --> actor : Saved / loaded state or retained-input error
@enduml
