@startuml
title L2-023 - Browse photographer portfolios and linked inspiration
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Library owner" as actor
box "Frontend - Loupe application / domain / api" #E0F2FE
participant "PhotographerDetailPanel" as page
participant "PhotographerService" as client
end box
box "Backend - Loupe API application" #D1FADF
participant "PhotographersController" as controller
end box
box "Backend - Loupe Application and Domain" #ECFDF3
participant "ListPhotographersQueryHandler" as handler
participant "PhotographerBookmark" as entity
end box
box "Backend - Loupe Infrastructure" #FFF4E5
database "Library store" as db
end box
actor -> page : Browse photographer portfolios and linked inspiration
page -> client : cursor?, pageSize?; linked-reference cursor?
client -> controller : GET /api/photographers; GET /api/photographers/{id}
note over controller : API middleware authenticates; controller binds only
controller -> handler : MediatR dispatch ListPhotographersQuery
handler -> db : Load / validate owner-scoped state before side effects
db --> handler : Owned state or unavailable result
handler -> db : Page owned bookmarks / detail and linked references [L2-023]
db --> handler : Names, hostnames, provenance, notes, tags, processing status
note over page : Named preview placeholder; Link references when empty
note over handler : Opening detail performs no external fetch or AI work
handler --> controller : 200 stable page/detail with protected portfolio action
controller --> client : Typed HTTP response / ProblemDetails
client --> page : Update state signals
page --> actor : Saved / loaded state or retained-input error
@enduml
