@startuml
title L2-005 - Compare two saved attempts
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Library owner" as actor
box "Frontend - Loupe application / domain / api" #E0F2FE
participant "AttemptComparison" as page
participant "ComparisonService" as client
end box
box "Backend - Loupe API application" #D1FADF
participant "ComparisonsController" as controller
end box
box "Backend - Loupe Application and Domain" #ECFDF3
participant "GetComparisonQueryHandler" as handler
participant "ComparisonSelection" as entity
end box
box "Backend - Loupe Infrastructure" #FFF4E5
database "Library store" as db
end box
actor -> page : Compare two saved attempts
page -> client : firstId, secondId
client -> controller : GET /api/comparisons
note over controller : API middleware authenticates; controller binds only
controller -> handler : MediatR dispatch GetComparisonQuery
handler -> db : Load / validate owner-scoped state before side effects
db --> handler : Owned state or unavailable result
handler -> entity : Require exactly two distinct IDs [L2-005]
handler -> db : Resolve both owned, available photographs
db --> handler : Current successful critiques and attempt details
alt unavailable ID or ineligible attempt
handler --> controller : 404 unavailable / 400 ineligible
opt existing comparison loses one side
client -> controller : Fetch each owned detail separately
controller -> handler : Dispatch GetPhotographQuery for each side
handler -> db : Read surviving owned detail
db --> handler : Surviving attempt
handler --> controller : Available side / unavailable side
controller --> client : Keep survivor; offer replacement picker
end
else eligible pair
handler --> controller : Both saved attempts; no job created
end
handler --> controller : 200 pair; preserve available side after deletion
controller --> client : Typed HTTP response / ProblemDetails
client --> page : Update state signals
page --> actor : Saved / loaded state or retained-input error
@enduml
