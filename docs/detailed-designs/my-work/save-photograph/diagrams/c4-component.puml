@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Save a photograph and its brief
Container_Boundary(web, "Loupe Angular client") {
Component(work, "MyWork", "Application", "Retains collection and owns dialog lifetime")
Component(dialog, "PhotographUploadDialog", "Application", "Native modal, focus, dismissal and critique admission")
Component(spa, "PhotographUpload", "Domain", "Signal draft, validation and upload through PHOTOGRAPH_SERVICE")
Rel(work, dialog, "Opens from header or empty state")
Rel(dialog, spa, "Composes")
}
Container_Boundary(api, "Loupe API and Application") {
Component(ctrl, "PhotographsController", "API controller", "Binds, dispatches, returns")
Component(handler, "UploadPhotographCommandHandler\nUpdatePhotographBriefCommandHandler", "Application / MediatR 12.5.0", "Validates, authorizes, coordinates slice")
Component(entity, "Photograph", "Domain", "State and local invariants")
Component(store, "ILibraryStore", "Application port", "Owner-scoped transactional reads and writes")
}
ContainerDb(db, "Library store", "Infrastructure adapter", "Authoritative data and durable work")
Rel(spa, ctrl, "Calls through IPhotographService", "HTTPS")
Rel(ctrl, handler, "Dispatches request", "MediatR")
Rel(handler, entity, "Reads or applies behavior")
Rel(handler, store, "Uses inward-defined port")
Rel(store, db, "Implemented by Infrastructure")
Component(ports, "IImageIngestor / IImageStore", "Application ports", "Implemented by configured Infrastructure adapters")
Rel(handler, ports, "Uses explicit capability")
@enduml
