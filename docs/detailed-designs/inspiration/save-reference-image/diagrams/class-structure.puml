@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Save or replace a reference image
class Reference {
  +Id: Guid
  +OwnerId: string
  +ImageRevision: long
  +Image: ImageAsset?
  +Title: string
  +Attribution: string?
  +Notes: string?
  +Version: long
  +ReplaceImage(image: ImageAsset): void
}
interface ILibraryStore {
  +ReadOwned(ownerId: string, id: Guid): Task<OwnedState>
  +Commit(expectedVersion: long): Task<CommitResult>
}
class UploadReferenceCommand {
  +OwnerId: string
  +Payload: UploadReferenceInput
}
class UploadReferenceCommandHandler {
  +Handle(request: UploadReferenceCommand, cancellation: CancellationToken): Task<Result>
}
UploadReferenceCommandHandler ..> UploadReferenceCommand : handles
UploadReferenceCommandHandler --> Reference : reads / applies
UploadReferenceCommandHandler ..> ILibraryStore : persists / queries
class ReplaceReferenceImageCommand {
  +OwnerId: string
  +Payload: ReplaceReferenceImageInput
}
class ReplaceReferenceImageCommandHandler {
  +Handle(request: ReplaceReferenceImageCommand, cancellation: CancellationToken): Task<Result>
}
ReplaceReferenceImageCommandHandler ..> ReplaceReferenceImageCommand : handles
ReplaceReferenceImageCommandHandler --> Reference : reads / applies
ReplaceReferenceImageCommandHandler ..> ILibraryStore : persists / queries
interface IImageIngestor {
  +Stage(input: ImageUpload, ct: CancellationToken): Task<StagedImage>
}
UploadReferenceCommandHandler ..> IImageIngestor : uses
interface IImageStore {
  +OpenOwned(key: string, ct: CancellationToken): Task<Stream>
  +DeleteUnreferenced(key: string): Task
}
UploadReferenceCommandHandler ..> IImageStore : uses
interface IReferenceService {
  +state: Signal<FeatureState>
}
class ReferenceService {
  -http: HttpClient
  +state: Signal<FeatureState>
}
ReferenceService ..|> IReferenceService
class ReferenceImagePanel {
  -service: IReferenceService
}
ReferenceImagePanel ..> IReferenceService : inject token
@enduml
