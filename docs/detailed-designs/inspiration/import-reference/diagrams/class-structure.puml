title Class structure - Import a source URL with manual fallback
class ReferenceImport {
  +ReferenceId: Guid
  +SubmittedUrl: Uri
  +FinalUrl: Uri?
  +SourceRevision: long
  +State: ImportState
  +FailureReason: string?
  +ApplyEmptyFields(result: ImportResult): void
  +Fail(reason: string): void
}
interface ILibraryStore {
  +ReadOwned(ownerId: string, id: Guid): Task<OwnedState>
  +Commit(expectedVersion: long): Task<CommitResult>
}
class ImportReferenceCommand {
  +OwnerId: string
  +Payload: ImportReferenceInput
}
class ImportReferenceCommandHandler {
  +Handle(request: ImportReferenceCommand, cancellation: CancellationToken): Task<Result>
}
ImportReferenceCommandHandler ..> ImportReferenceCommand : handles
ImportReferenceCommandHandler --> ReferenceImport : reads / applies
ImportReferenceCommandHandler ..> ILibraryStore : persists / queries
