@startuml
title L2-011 - Respect source restrictions and preserve a fallback
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Library owner" as actor
box "Frontend - Loupe application / domain / api" #E0F2FE
participant "ReferenceImportPanel" as page
participant "ReferenceImportService" as client
end box
box "Backend - Loupe API application" #D1FADF
participant "ReferenceImportsController" as controller
end box
box "Backend - Loupe Application and Domain" #ECFDF3
participant "RetryReferenceImportCommandHandler" as handler
participant "GetOperationQueryHandler" as status
participant "ReferenceImport" as entity
end box
box "Backend - Loupe Infrastructure" #FFF4E5
database "Library store" as db
participant "IRestrictedPageFetcher / IPreviewSelector / IImageIngestor adapters" as ext
participant "Durable work runner" as worker
end box
note over page, controller : Admission persists work before processing; status reads are owner-scoped
worker -> db : Lease admitted job and immutable input
db --> worker : Durable work
worker -> handler : Dispatch RetryReferenceImportCommand
handler -> db : Verify target owner, existence, and admitted revision
db --> handler : Current authorized state
handler -> ext : Check URL safety and origin robots before content [L2-011]
ext --> handler : Allowed / restricted / unavailable
alt disallow, login, paywall, denial, timeout, or invalid content
handler -> db : Preserve link-only record and actionable reason
note over ext : No alternate identity, credentials, automation, or proxy bypass
else permitted source
handler -> ext : Bounded import using declared user agent
ext --> handler : Result under current revision
handler -> db : Apply guarded result; retain original source
end
handler --> worker : Attempt outcome; release lease
actor -> page : Inspect processing result
page -> client : Read status
client -> controller : GET owned job / item status
controller -> status : Dispatch GetOperationQuery
status -> db : Read persisted state
db --> status : Job outcome and current item
status --> controller : Typed status
controller --> client : Save link / Add image / Edit notes on failure
client --> page : Update state signals
page --> actor : Labeled result and recovery action
@enduml
