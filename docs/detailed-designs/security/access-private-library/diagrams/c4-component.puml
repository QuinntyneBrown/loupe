@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Authentication components
Container(web, "Sign-in page", "Angular", "Injects SESSION_SERVICE")
Container_Boundary(api, "Loupe backend") {
Component(controller, "SessionsController", "API", "Binds, dispatches, returns")
Component(middleware, "Authentication / CSRF / rate limiting", "API", "Protects browser requests")
Component(handler, "SignInCommandHandler", "Application / MediatR 12.5.0", "Coordinates credential verification and session creation")
Component(ports, "IUserStore / IPasswordService / IJwtService / ISessionStore", "Application interfaces", "Persistence and cryptography contracts")
Component(adapters, "UserStore / PasswordService / JwtService / SessionStore", "Infrastructure", "PostgreSQL, password hashing, JWT signing and validation")
}
Rel(web, controller, "Calls through SessionService", "HTTPS")
Rel(middleware, controller, "Protects request")
Rel(controller, handler, "Dispatches", "MediatR")
Rel(handler, ports, "Uses")
Rel(adapters, ports, "Implements")
@enduml
