@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Sign in and access only the owned library
Container(spa, "SessionStatus", "Angular domain", "Injects SESSION_SERVICE")
Container_Boundary(api, "Loupe API and Application") {
Component(ctrl, "SessionsController", "API controller", "Binds, dispatches, returns")
Component(handler, "CompleteSignInCommandHandler\nGetOwnedResourceQueryHandler", "Application / MediatR 12.5.0", "Validates, authorizes, coordinates slice")
Component(entity, "ApplicationSession", "Domain", "State and local invariants")
Component(store, "ILibraryStore", "Application port", "Owner-scoped transactional reads and writes")
}
ContainerDb(db, "Library store", "Infrastructure adapter", "Authoritative data and durable work")
Rel(spa, ctrl, "Calls through ISessionService", "HTTPS")
Rel(ctrl, handler, "Dispatches request", "MediatR")
Rel(handler, entity, "Reads or applies behavior")
Rel(handler, store, "Uses inward-defined port")
Rel(store, db, "Implemented by Infrastructure")
Component(ports, "IIdentityProvider / ISessionStore", "Application ports", "Implemented by configured Infrastructure adapters")
Rel(handler, ports, "Uses explicit capability")
@enduml
