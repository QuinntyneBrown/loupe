@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Local account containers
Person(owner, "Photographer")
Person(operator, "Administrator")
System_Boundary(loupe, "Loupe") {
Container(web, "Web client", "Angular", "Email/password form and private library")
Container(api, "API", "ASP.NET Core", "Issues and validates JWT sessions")
Container(admin, "Admin CLI", ".NET", "Create user and reset password")
ContainerDb(db, "Library database", "PostgreSQL", "Users, password hashes, sessions, owned content")
}
Rel(owner, web, "Uses", "HTTPS")
Rel(operator, admin, "Runs with hidden password input")
Rel(web, api, "JSON, HttpOnly cookie, antiforgery", "HTTPS")
Rel(api, db, "Authenticates and accesses owned data", "EF Core")
Rel(admin, db, "Provisions accounts and revokes sessions", "EF Core")
@enduml
