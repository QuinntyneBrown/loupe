@startuml
skinparam shadowing false
title Local users and sessions
class User {
  Id: string
  NormalizedEmail: string
  PasswordHash: string
  PasswordVersion: string
}
class ApplicationSession {
  Id: token hash
  Subject: user ID
  UserVersion: string
  CreatedAt: DateTimeOffset
  LastSeenAt: DateTimeOffset
}
class SignInCommandHandler
class CreateUserCommandHandler
class ResetPasswordCommandHandler
interface IUserStore
interface IPasswordService
interface IJwtService
interface ISessionStore
SignInCommandHandler ..> IUserStore
SignInCommandHandler ..> IPasswordService
SignInCommandHandler ..> IJwtService
SignInCommandHandler ..> ISessionStore
CreateUserCommandHandler ..> IUserStore
CreateUserCommandHandler ..> IPasswordService
ResetPasswordCommandHandler ..> IUserStore
ResetPasswordCommandHandler ..> IPasswordService
IUserStore ..> User
ISessionStore ..> ApplicationSession
ApplicationSession --> User : subject and password version
@enduml
