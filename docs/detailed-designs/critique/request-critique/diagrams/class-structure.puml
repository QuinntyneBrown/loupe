@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Request or replace a critique
class CritiqueJob {
  +Id: Guid
  +OwnerId: string
  +PhotographId: Guid
  +InputFingerprint: string
  +BriefSnapshot: CritiqueBrief
  +Mode: ExecutionMode
  +State: JobState
  +Queue(snapshot: CritiqueInput): void
  +Complete(result: CritiqueResult): void
}
interface ILibraryStore {
  +ReadOwned(ownerId: string, id: Guid): Task<OwnedState>
  +Commit(expectedVersion: long): Task<CommitResult>
}
class RequestCritiqueCommand {
  +OwnerId: string
  +Payload: RequestCritiqueInput
}
class RequestCritiqueCommandHandler {
  +Handle(request: RequestCritiqueCommand, cancellation: CancellationToken): Task<Result>
}
RequestCritiqueCommandHandler ..> RequestCritiqueCommand : handles
RequestCritiqueCommandHandler --> CritiqueJob : reads / applies
RequestCritiqueCommandHandler ..> ILibraryStore : persists / queries
interface ICritiqueService {
  +state: Signal<FeatureState>
}
class CritiqueService {
  -http: HttpClient
  +state: Signal<FeatureState>
}
CritiqueService ..|> ICritiqueService
class CritiquePanel {
  -service: ICritiqueService
}
CritiquePanel ..> ICritiqueService : inject token
@enduml
