@startuml
title L2-006 - Deliver a structured, actionable critique
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}

actor "Library owner" as actor
box "Frontend - Loupe application / domain / api" #E0F2FE
participant "CritiquePanel" as page
participant "CritiqueService" as client
end box
box "Backend - Loupe API application" #D1FADF
participant "CritiquesController" as controller
end box
box "Backend - Loupe Application and Domain" #ECFDF3
participant "GenerateCritiqueCommandHandler" as handler
participant "GetOperationQueryHandler" as status
participant "CritiqueResult" as entity
end box
box "Backend - Loupe Infrastructure" #FFF4E5
database "Library store" as db
participant "ICritiqueProvider adapters" as ext
participant "Durable work runner" as worker
end box
note over page, controller : Admission persists work before processing; status reads are owner-scoped
worker -> db : Lease admitted job and immutable input
db --> worker : Durable work
worker -> handler : Dispatch GenerateCritiqueCommand
handler -> db : Verify target owner, existence, and admitted revision
db --> handler : Current authorized state
handler -> ext : Analyze immutable image, EXIF, and brief [L2-006]
ext --> handler : Structured candidate result
handler -> entity : Validate sections, explanations, 3 priorities, 1 exercise
alt invalid result / provider failure
handler -> db : Record failed attempt; retain current critique
else fully valid current job
handler -> db : Atomically publish result + timestamp + mode + brief snapshot
db --> handler : New current critique; notes unchanged
end
handler --> worker : Attempt outcome; release lease
actor -> page : Inspect processing result
page -> client : Read status
client -> controller : GET owned job / item status
controller -> status : Dispatch GetOperationQuery
status -> db : Read persisted state
db --> status : Job outcome and current item
status --> controller : Typed status
controller --> client : job status and current critique
client --> page : Update state signals
page --> actor : Labeled result and recovery action
@enduml
