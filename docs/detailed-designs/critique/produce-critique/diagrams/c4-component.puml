@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Produce and evaluate an evidence-based critique
Container(spa, "CritiquePanel", "Angular domain", "Injects CRITIQUE_SERVICE")
Container_Boundary(api, "Loupe API and Application") {
Component(ctrl, "CritiquesController", "API controller", "Binds, dispatches, returns")
Component(handler, "GenerateCritiqueCommandHandler", "Application / MediatR 12.5.0", "Validates, authorizes, coordinates slice")
Component(entity, "CritiqueResult", "Domain", "State and local invariants")
Component(store, "ILibraryStore", "Application port", "Owner-scoped transactional reads and writes")
}
ContainerDb(db, "Library store", "Infrastructure adapter", "Authoritative data and durable work")
Rel(spa, ctrl, "Calls through ICritiqueService", "HTTPS")
Rel(ctrl, handler, "Dispatches request", "MediatR")
Rel(handler, entity, "Reads or applies behavior")
Rel(handler, store, "Uses inward-defined port")
Rel(store, db, "Implemented by Infrastructure")
Container(worker, "Loupe worker", ".NET", "Processes durable admitted work")
Rel(worker, handler, "Dispatches background command", "MediatR")
Component(ports, "ICritiqueProvider", "Application ports", "Implemented by configured Infrastructure adapters")
Rel(handler, ports, "Uses explicit capability")
Container(evaluation, "Loupe Evaluation", ".NET CLI", "Runs fixed critique fixtures with named review")
Component(evaluator, "EvaluateCritiqueCommandHandler", "Application", "Evaluates release evidence separately from production jobs")
Rel(evaluation, evaluator, "Dispatches evaluation")
Rel(evaluator, ports, "Runs configured provider against fixtures")
@enduml
