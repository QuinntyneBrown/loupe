@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Organize references with private boards
Container(spa, "BoardReferenceCollection", "Angular domain", "Injects BOARD_SERVICE")
Container_Boundary(api, "Loupe API and Application") {
Component(ctrl, "BoardsController", "API controller", "Binds, dispatches, returns")
Component(handler, "CreateBoardCommandHandler\nSetReferenceBoardsCommandHandler\nDeleteBoardCommandHandler", "Application / MediatR 12.5.0", "Validates, authorizes, coordinates slice")
Component(entity, "Board", "Domain", "State and local invariants")
Component(store, "ILibraryStore", "Application port", "Owner-scoped transactional reads and writes")
}
ContainerDb(db, "Library store", "Infrastructure adapter", "Authoritative data and durable work")
Rel(spa, ctrl, "Calls through IBoardService", "HTTPS")
Rel(ctrl, handler, "Dispatches request", "MediatR")
Rel(handler, entity, "Reads or applies behavior")
Rel(handler, store, "Uses inward-defined port")
Rel(store, db, "Implemented by Infrastructure")
@enduml
