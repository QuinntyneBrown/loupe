@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Track durable processing and retry failures
Container(spa, "OperationStatusPanel", "Angular domain", "Injects OPERATION_SERVICE")
Container_Boundary(api, "Loupe API and Application") {
Component(ctrl, "OperationsController", "API controller", "Binds, dispatches, returns")
Component(handler, "RunBackgroundOperationCommandHandler\nExecuteOperationAttemptCommandHandler", "Application / MediatR 12.5.0", "Validates, authorizes, coordinates slice")
Component(entity, "BackgroundOperation", "Domain", "State and local invariants")
Component(store, "ILibraryStore", "Application port", "Owner-scoped transactional reads and writes")
}
ContainerDb(db, "Library store", "Infrastructure adapter", "Authoritative data and durable work")
Rel(spa, ctrl, "Calls through IOperationService", "HTTPS")
Rel(ctrl, handler, "Dispatches request", "MediatR")
Rel(handler, entity, "Reads or applies behavior")
Rel(handler, store, "Uses inward-defined port")
Rel(store, db, "Implemented by Infrastructure")
Container(worker, "Loupe worker", ".NET", "Processes durable admitted work")
Rel(worker, handler, "Dispatches background command", "MediatR")
Component(ports, "IProviderInvoker", "Application ports", "Implemented by configured Infrastructure adapters")
Rel(handler, ports, "Uses explicit capability")
@enduml
