@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Admit analysis fairly and reuse completed work
Container(spa, "AnalysisRequestPanel", "Angular domain", "Injects ANALYSIS_SERVICE")
Container_Boundary(api, "Loupe API and Application") {
Component(ctrl, "AnalysisController", "API controller", "Binds, dispatches, returns")
Component(handler, "AdmitAnalysisCommandHandler", "Application / MediatR 12.5.0", "Validates, authorizes, coordinates slice")
Component(entity, "AnalysisFingerprint", "Domain", "State and local invariants")
Component(store, "ILibraryStore", "Application port", "Owner-scoped transactional reads and writes")
}
ContainerDb(db, "Library store", "Infrastructure adapter", "Authoritative data and durable work")
Rel(spa, ctrl, "Calls through IAnalysisService", "HTTPS")
Rel(ctrl, handler, "Dispatches request", "MediatR")
Rel(handler, entity, "Reads or applies behavior")
Rel(handler, store, "Uses inward-defined port")
Rel(store, db, "Implemented by Infrastructure")
Container(worker, "Loupe worker", ".NET", "Processes durable admitted work")
Rel(worker, handler, "Dispatches background command", "MediatR")
Component(ports, "IProviderCallScheduler", "Application ports", "Implemented by configured Infrastructure adapters")
Rel(handler, ports, "Uses explicit capability")
@enduml
