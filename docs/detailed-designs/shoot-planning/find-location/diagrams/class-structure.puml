title Class structure - Find a location for a shoot
class FindLocationsQuery {
  +Query: string?
  +Mode: string
  +ShootTypes: string[]
  +People: int?
  +TimesOfDay: string[]
  +Setting: string?
  +Tags: string[]
  +PageSize: int
  +Cursor: string?
}
class LocationSearchFilter {
  +Tokens: string[]
  +ShootTypes: ShootType[]
  +People: int?
  +TimesOfDay: TimeOfDay[]
  +Setting: LocationSetting?
  +Tags: string[]
  +RequiresReport: bool
}
class LocationSearchCursor {
  +{static} Scope(ownerId: string, mode: string, filter: LocationSearchFilter, pageSize: int): string
  +{static} Encode(cursor: CreatedCursor, scope: string): string
  +{static} Parse(value: string?, scope: string): CreatedCursor?
}
class SemanticCursor {
  +GenerationId: Guid
  +ModelIdentity: string
  +LastScore: double
  +LastId: Guid
  +FilterFingerprint: string
}
class LocationSearchItem {
  +Id: Guid
  +Name: string
  +Locality: string?
  +CoverPreviewUrl: string?
  +ImageCount: int
  +HasReport: bool
  +RecommendedPeriods: TimeOfDay[]
  +GroupMinimum: int?
  +GroupMaximum: int?
  +GroupCannotAssess: bool
  +Ratings: IReadOnlyDictionary<ShootType, SuitabilityRating>
  +CreatedAt: DateTimeOffset
}
class LocationSearchPage {
  +Items: IReadOnlyList<LocationSearchItem>
  +NextCursor: string?
