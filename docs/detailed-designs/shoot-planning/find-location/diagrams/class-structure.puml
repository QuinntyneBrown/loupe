}
interface IEmbeddingProvider {
  +Embed(text: string, model: string, ct: CancellationToken): Task<Vector>
}
interface IVectorSearchReader {
  +Rank(owner: string, vector: Vector, filter: LocationSearchFilter, cursor: SemanticCursor?, ct: CancellationToken): Task<RankedPage>
}
interface IVectorWriter {
  +Publish(document: SearchDocument, vector: Vector, expectedRevision: long, ct: CancellationToken): Task<bool>
}
